STOWARR_APPROVAL_USER=stowarr
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
STOWARR_APPROVAL_PASSWORD=
# Eligible Jellyfin user ID for live watch-state rechecks before staging.
STOWARR_EXECUTOR_JELLYFIN_USER_ID=
# qBittorrent endpoint used for isolated replacement acquisition and reconciliation.
STOWARR_QBITTORRENT_URL=http://gluetun:8090
# Must match the dedicated Radarr/qBittorrent category; never use a general category.
STOWARR_QBITTORRENT_CATEGORY=stowarr
# Replacement downloads must use a qBittorrent category that Radarr does not monitor.
STOWARR_REPLACEMENT_CATEGORY=stowarr-replacement
# Absolute path visible identically to qBittorrent and the Stowarr container.
# Leave empty until the shared path has been verified in staging.
STOWARR_REPLACEMENT_PATH=
# Optional JSON mapping when Radarr and Stowarr use different container paths.
# Every Radarr root must be mapped to an existing Stowarr-visible path before
# overlap checks can pass, for example {"/movies":"/mnt/movies"}.
STOWARR_RADARR_ROOT_PATH_MAP=
# Verification is bounded for a four-thread/8 GB NAS; values above four workers
# are rejected. These jobs are read-only and do not import or move media.
STOWARR_VERIFY_WORKERS=4
STOWARR_VERIFY_MAX_BYTES=34359738368
STOWARR_VERIFY_MAX_SECONDS=1800
# Optional qBittorrent Web API credentials. Keep values only in .env.approvals.
STOWARR_QBITTORRENT_USERNAME=
STOWARR_QBITTORRENT_PASSWORD=
# Optional, comma-separated: email,webhook. Empty = web page only.
STOWARR_NOTIFY_CHANNELS=
# Required for notifications: reachable private origin, no credentials.
STOWARR_APPROVAL_URL=
STOWARR_SMTP_HOST=
STOWARR_SMTP_PORT=587
STOWARR_SMTP_FROM=
STOWARR_SMTP_TO=
STOWARR_SMTP_USER=
STOWARR_SMTP_PASSWORD=
# Generic JSON webhook; adapt via n8n/Home Assistant/etc. HTTPS required.
STOWARR_WEBHOOK_URL=
STOWARR_WEBHOOK_TOKEN=
