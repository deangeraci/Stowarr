STOWARR_APPROVAL_USER=stowarr
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
STOWARR_APPROVAL_PASSWORD=
# Optional, comma-separated: email,webhook. Empty = web page only.
STOWARR_NOTIFY_CHANNELS=
# Required for notifications: reachable private origin, no credentials.
STOWARR_APPROVAL_URL=
STOWARR_SMTP_HOST=
STOWARR_SMTP_PORT=587
STOWARR_SMTP_FROM=
STOWARR_SMTP_TO=
STOWARR_SMTP_USER=
STOWARR_SMTP_PASSWORD=
# Generic JSON webhook; adapt via n8n/Home Assistant/etc. HTTPS required.
STOWARR_WEBHOOK_URL=
STOWARR_WEBHOOK_TOKEN=
